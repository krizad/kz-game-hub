{
  "name": "kz-game-hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:fix:web": "pnpm -F web lint:fix",
    "lint:fix:api": "pnpm -F api lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm -F @repo/database db:generate",
    "db:use:mysql": "pnpm -F @repo/database db:use:mysql",
    "db:use:pg": "pnpm -F @repo/database db:use:pg",
    "db:migrate": "pnpm -F @repo/database db:migrate",
    "db:reset": "pnpm -F @repo/database db:reset",
    "db:push": "pnpm -F @repo/database db:push",
    "db:studio": "pnpm -F @repo/database db:studio",
    "db:seed": "pnpm -F @repo/database db:seed",
    "start": "turbo run start",
    "test:e2e": "pnpm -F web test:e2e",
    "test:e2e:ui": "pnpm -F web test:e2e:ui",
    "deploy:ftp": "node scripts/deploy-api-ftp.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "basic-ftp": "^6.2.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.2.5",
    "turbo": "^2.9.18",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@9.1.0",
  "pnpm": {
    "patchedDependencies": {
      "playwright@1.61.0": "patches/playwright@1.61.0.patch"
    }
  }
}
