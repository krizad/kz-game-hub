# ==========================================
# Root Configuration for the kz-game-hub
# ==========================================

# Web Frontend (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Public URL for metadata and OpenGraph images (defaults to https://game-hub.krizad.com if unset)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API Backend (apps/api)
PORT=3001
# Allowed browser origins (comma-separated). E2E tests need the :3100 origins.
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100"

# Database Configuration (packages/database)
# The Prisma datasource provider is auto-detected from this URL by
# packages/database/scripts/sync-schema.ts (mysql:// → mysql, postgresql:// → postgresql).
# Keep this on a LOCAL MySQL for development (see boot guard in
# packages/database/src/index.ts: a remote URL is rejected outside production
# unless ALLOW_REMOTE_DATABASE_URL=1). For a local MySQL via docker compose
# (host port 3307 → container 3306, root/password, db kz_game_hub):
# Format: mysql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL="mysql://root:password@localhost:3307/kz_game_hub"
# Explicit opt-in to load a non-loopback DATABASE_URL outside production.
ALLOW_REMOTE_DATABASE_URL=0

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# Admin key for the in-lobby game enable/disable panel (set_game_enabled).
# Leave unset to disable the admin endpoint entirely.
ADMIN_SECRET="change-me"

# Spotify API (for Music Trivia game)
# Get credentials from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"

# Detective Club card images (optional; defaults to the bundled cards when unset)
DETECTIVE_CLUB_CARDS_DIR=""

# Logging & connection resilience (optional)
LOG_FILE_NAME="game-hub.logs"
LOG_LEVEL="log"
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5
RECONNECT_GRACE_MS=120000
# Room lifecycle & WebSocket rate-limiting (optional)
MAX_ROOMS=200
IDLE_ROOM_TTL_MS=7200000
DISABLE_RATE_LIMIT=0
# Per-room player cap for JOIN_ROOM (any game; seated reconnects bypass it).
MAX_PLAYERS=20
# Rate-limit buckets (see apps/api/src/games/ws-rate-limit.service.ts).
# Admin events: N attempts per window per IP, then a lockout.
RATE_LIMIT_ADMIN_MAX=5
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_LOCKOUT_MS=300000
# CREATE_ROOM per socket, per window.
RATE_LIMIT_CREATE_ROOM_MAX=5
RATE_LIMIT_CREATE_ROOM_WINDOW_MS=60000
# Events that call external APIs (Who Am I AI words, Music Trivia search) per socket.
RATE_LIMIT_EXTERNAL_MAX=10
RATE_LIMIT_EXTERNAL_WINDOW_MS=60000
# General mutating events per socket.
RATE_LIMIT_GENERAL_MAX=60
RATE_LIMIT_GENERAL_WINDOW_MS=10000
# How many reverse proxies sit in front of the API and append (not replace)
# x-forwarded-for. Default 0: the header is IGNORED (clients can forge it) and
# the socket's own address keys the admin bucket. Set to N only behind exactly
# N proxies, e.g. TRUSTED_PROXY_HOPS=1 behind one nginx.
TRUSTED_PROXY_HOPS=0

# API FTP deploy (scripts/deploy-api-ftp.mjs; CI injects these as secrets)
FTP_HOST=""
FTP_USER=""
FTP_PASS=""
FTP_REMOTE_DIR="/"
FTP_SECURE=false

# API logging destinations (optional)
# LOG_TO_FILE=1 writes LOG_FILE_NAME next to the running app; LOG_DIR overrides the directory.
LOG_TO_FILE=0
LOG_DIR=""

# E2E/dev isolation: skip loading GameSetting flags from the database
# (injected per-server by the Playwright webServer commands; do not set job-wide,
# game-settings.service.spec exercises the DB path).
DISABLE_GAME_SETTINGS_DB=0
# Frontend socket tuning (optional)
NEXT_PUBLIC_SOCKET_TRANSPORTS="polling,websocket"
NEXT_PUBLIC_KEEPALIVE_INTERVAL_MS=90000
