{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_APP_URL"],
  "globalPassThroughEnv": [
    "PORT",
    "TEST_DATABASE_URL",
    "DISABLE_GAME_SETTINGS_DB",
    "CORS_ORIGIN",
    "ADMIN_SECRET",
    "GEMINI_API_KEY",
    "SPOTIFY_CLIENT_ID",
    "SPOTIFY_CLIENT_SECRET",
    "DETECTIVE_CLUB_CARDS_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    }
  }
}
